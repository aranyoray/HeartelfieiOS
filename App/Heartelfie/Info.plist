<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Heartelfie</string>
	<key>CFBundleName</key>
	<string>Heartelfie</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Permission usage strings: calm, specific, non-alarmist. -->
	<key>NSCameraUsageDescription</key>
	<string>Heartelfie uses the camera to take a gentle heart-rate screening from your fingertip or face. This is a wellness screening, not a medical measurement.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Heartelfie connects over Bluetooth to your Heartelfie device for higher-confidence measurements.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Heartelfie can read heart-health data (like heart rate and HRV) to give you a fuller picture of your trends. You stay in control of what is shared.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Heartelfie can save your screening results (like heart rate and HRV) to Apple Health so your data stays portable.</string>

	<!-- The app uses only standard/exempt encryption (Apple CryptoKit AES-GCM for
	     local data at rest and HTTPS/ATS for transport), so it is exempt from
	     export-compliance documentation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
