{
  "name": "dailydilweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DailyDil — US county & state heart & circulatory wellness-awareness atlas (CDC PLACES). Tilted 3D map of age-adjusted, community-level wellness indicators across years. Describes geographic areas, never individuals; not medical advice.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender-routes.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "data:placeholder": "node scripts/gen-placeholder.mjs",
    "data:scrape": "node scripts/scrape-cdc.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.4",
    "@deck.gl/layers": "^9.3.4",
    "@deck.gl/react": "^9.3.4",
    "d3-array": "^3.2.4",
    "d3-color": "^3.1.0",
    "d3-geo": "^3.1.1",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "fuse.js": "^7.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "recharts": "^2.15.4",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "us-zips": "^2022.9.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-color": "^3.1.3",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
