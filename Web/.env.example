# --- CDC PLACES scraper (scripts/scrape-cdc.mjs) -------------------------------
# These only matter when running `npm run data:scrape` to pull REAL data.
# Requires data.cdc.gov to be reachable (add it to your network egress allowlist).

# Optional Socrata app token for higher rate limits (not required for small pulls).
CDC_APP_TOKEN=

# Comma-separated CDC PLACES *county* release dataset ids to place on the time
# axis. Each PLACES release is typically one data year; add more ids for more
# years. Find ids at https://data.cdc.gov (search "PLACES County Data").
#   swc5-untb = PLACES: Local Data for Better Health, County Data, 2025 release
PLACES_COUNTY_DATASETS=swc5-untb
